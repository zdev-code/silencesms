<?xml version="1.0" encoding="utf-8"?>

<!-- This fragment owns its media background independently of the host activity theme. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/gray95"
                tools:ignore="Overdraw">

    <org.smssecure.smssecure.components.ZoomingImageView
               android:id="@+id/image"
               android:layout_width="match_parent"
               android:layout_height="match_parent"
               android:contentDescription="@string/media_preview_activity__image_content_description" />

    <org.smssecure.smssecure.video.VideoPlayer
            android:id="@+id/video_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

</RelativeLayout>
